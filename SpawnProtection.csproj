<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugSymbols>False</DebugSymbols>
		<DebugType>None</DebugType>
		<PublishDir>./bin/SpawnProtection/</PublishDir>
	</PropertyGroup>
	<PropertyGroup>
		<!-- net10.0 and CounterStrikeSharp.API 1.0.374 are PanoramaManager's floor: the package targets net10.0 and
		     declares that CSS version, so a lower pin fails restore with NU1605. The servers run CSS 1.0.380. -->
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="CounterStrikeSharp.API" Version="1.0.374" />

		<!-- The spawn protection pill (SpawnHud.cs). Copied next to the plugin by CopyPanoramaManager below:
		     each CounterStrikeSharp plugin loads from its own folder, and the deps.json (no longer turned off)
		     is what points the loader at it. Same version as our other HUD plugins. -->
		<PackageReference Include="PanoramaManager" Version="0.4.3" />
	</ItemGroup>
	<ItemGroup>
		<None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- A class library does not copy package dlls on build, and turning CopyLocalLockFileAssemblies on would
	     copy CounterStrikeSharp.API's whole tree. This copies PanoramaManager only. -->
	<Target Name="CopyPanoramaManager" AfterTargets="ResolveLockFileCopyLocalFiles">
		<ItemGroup>
			<ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)"
			                         Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'PanoramaManager'" />
		</ItemGroup>
	</Target>
</Project>
